# URI PostgreSQL do Supabase. Obtenha em Project Settings > Database > Connection string.
# Use a URL "URI" e codifique caracteres especiais da senha como URL-encoding.
DATABASE_URL=

PORT=3000
NODE_ENV=development
DB_POOL_MAX=10

# Opcional: certificado CA PEM do projeto (mantenha a validação TLS habilitada).
# SUPABASE_CA_CERT=
